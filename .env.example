# Copy to .env.local and fill in. Everything is optional: without these the cookbook still works,
# it just has no sign-in, shared recipes, shared photos or favorites sync.
# See docs/SHARING_SETUP.md.

# Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary dashboard: your cloud name, and the name of an UNSIGNED upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
