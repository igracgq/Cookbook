rules_version = '2';

// Heritage Cookbook: anyone may read; only people signed in with Google may contribute.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isCloudinaryUrl(u) {
      return u is string && u.size() <= 500 && u.matches('^https://res\\.cloudinary\\.com/.+');
    }
    // The owner(s) of the cookbook: a person is an admin when a document admins/{their uid} exists. Only the
    // Firebase console can create those documents (nobody can write to /admins from the app).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }
    function validCategory(c) {
      return c in ['APPETIZERS', 'BEVERAGES', 'SOUPS', 'SALADS', 'VEGETABLES', 'PICKLING', 'RICE_AND_RISOTTO',
                   'PASTA_AND_SAUCES', 'BAKED_PASTA', 'MEATS', 'SEAFOOD', 'EGGS', 'BREADS_AND_PIZZA',
                   'COOKIES_AND_BISCOTTI', 'CAKES_AND_DESSERTS', 'HOLIDAY_TRADITIONS', 'TARTS_AND_PIES', 'DIETS'];
    }

    // A signed-in person may check whether they themselves are an admin (to show the moderation buttons).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // One document per member: profile and favorites. Only that member can read or change it.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'lastSignIn', 'favorites'])
        && (!('displayName' in request.resource.data) || shortText(request.resource.data.displayName, 200))
        && (!('photoURL' in request.resource.data) || shortText(request.resource.data.photoURL, 1000))
        && (!('favorites' in request.resource.data)
            || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 2000));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Private cooking notes, one document per recipe under the member's own user document.
    // Nobody else can read or change them.
    match /users/{uid}/notes/{recipeId} {
      function validNote(d) {
        return d.keys().hasOnly(['text', 'updatedAt'])
          && shortText(d.text, 5000)
          && d.updatedAt == request.time;
      }
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && recipeId.matches('^[A-Za-z0-9_-]{1,100}$') && validNote(request.resource.data);
    }

    // The member's shopping list: one document (users/{uid}/lists/shopping) holding the whole list.
    match /users/{uid}/lists/{listId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && listId == 'shopping'
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    // Recipes added by family members. The photo is a Cloudinary URL, never image data.
    match /recipes/{recipeId} {
      function validRecipe(d) {
        return d.keys().hasOnly(['title', 'category', 'servings', 'prepTime', 'cookTime', 'ingredients',
                                 'instructions', 'notes', 'imageUrl', 'authorUid', 'authorName', 'createdAt'])
          && shortText(d.title, 120) && d.title.size() >= 1
          && validCategory(d.category)
          && shortText(d.servings, 60) && shortText(d.prepTime, 60) && shortText(d.cookTime, 60)
          && d.ingredients is list && d.ingredients.size() >= 1 && d.ingredients.size() <= 60
          && d.instructions is list && d.instructions.size() >= 1 && d.instructions.size() <= 60
          && shortText(d.notes, 2000)
          && (d.imageUrl == '' || isCloudinaryUrl(d.imageUrl))
          && shortText(d.authorName, 200);
      }

      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validRecipe(request.resource.data);
      // Only the author can edit, and never the owner or creation time.
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validRecipe(request.resource.data);
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // One shared photo per cookbook recipe (the document id is the recipe id). Only the person who
    // shared it can replace or remove it.
    match /recipePhotos/{recipeId} {
      function validPhoto(d) {
        return d.keys().hasOnly(['imageUrl', 'uploadedBy', 'uploadedByName', 'updatedAt'])
          && isCloudinaryUrl(d.imageUrl)
          && d.uploadedBy == request.auth.uid
          && shortText(d.uploadedByName, 200)
          && d.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if signedIn() && recipeId.matches('^[A-Za-z0-9_-]{1,100}$') && validPhoto(request.resource.data);
      allow update: if signedIn() && resource.data.uploadedBy == request.auth.uid && validPhoto(request.resource.data);
      allow delete: if signedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // Tips shared with everyone, one per member per recipe (the document id is the member's uid).
    // Only that member can write, replace or remove their tip.
    match /recipeTips/{recipeId}/tips/{uid} {
      function validTip(d) {
        return d.keys().hasOnly(['text', 'authorName', 'updatedAt'])
          && shortText(d.text, 1000) && d.text.size() >= 1
          && shortText(d.authorName, 200)
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && recipeId.matches('^[A-Za-z0-9_-]{1,100}$') && validTip(request.resource.data);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Comments under the photos in the Photos section. The document path is photoComments/{photoId}/comments/{id}.
    // Anyone can read them; signed-in members add their own; only the author (or an admin) can delete one. No editing.
    match /photoComments/{photoId}/comments/{commentId} {
      function validComment(d) {
        return d.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorPhoto', 'createdAt'])
          && shortText(d.text, 1000) && d.text.size() >= 1
          && d.authorUid == request.auth.uid
          && shortText(d.authorName, 200)
          && (!('authorPhoto' in d) || shortText(d.authorPhoto, 1000))
          && d.createdAt == request.time;
      }
      allow read: if true;
      allow create: if signedIn() && photoId.matches('^[A-Za-z0-9_-]{1,120}$') && validComment(request.resource.data);
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Reactions to the photos in the Photos section: one per member per photo (the document id is the member's uid).
    // Anyone can read them; a member sets, changes or removes only their own.
    match /photoReactions/{photoId}/reactions/{uid} {
      function validReaction(d) {
        return d.keys().hasOnly(['type', 'authorName', 'updatedAt'])
          && d.type in ['like', 'love', 'yum', 'haha']
          && shortText(d.authorName, 200)
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && photoId.matches('^[A-Za-z0-9_-]{1,120}$') && validReaction(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
